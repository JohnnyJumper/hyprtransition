# Maintainer: JohnnyJumper <jeyhunt@gmail.com>
pkgname=hyprtransition-git
pkgver=r11.4551c3b
pkgrel=1
pkgdesc="Shader-driven workspace transitions for Hyprland (tear, burn, black hole, page turn, or your own GLSL) - git version"
arch=('x86_64' 'aarch64')
url="https://github.com/JohnnyJumper/hyprtransition"
license=('MIT')
depends=('wayland' 'libglvnd' 'grim' 'lua' 'hyprland')
makedepends=('git' 'wayland-protocols' 'pkgconf')
optdepends=('glslang: validate your own effects with make check')
provides=('hyprtransition')
conflicts=('hyprtransition')
source=("git+$url.git#branch=main")
sha256sums=('SKIP')

pkgver() {
    cd "${pkgname%-git}"
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    cd "${pkgname%-git}"
    make PREFIX=/usr
}

package() {
    cd "${pkgname%-git}"
    make PREFIX=/usr DESTDIR="$pkgdir" install
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
