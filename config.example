# hyprtransition settings — copy to ~/.config/hyprtransition/config
# Every key is optional. Shown values are the defaults. Lines starting with # are ignored.

# Effect to play (a file in an effects dir). A comma-separated list picks one at random per switch.
effect = tear

# Duration in ms. Leave unset to use the effect file's own "// duration:" line.
# duration = 700

# Include the mouse cursor in the captured screen.
cursor = false

# ---- Used by the Lua module only (dofile/require(...).setup()) ----

# Modifier of your workspace keys: binds mod+1..workspaces, mod+0 = next, mod+9 = prev.
mod = ALT
workspaces = 5

# Set to false to keep your own binds and call HyprTransition.go(i) / cycle("next") yourself.
bind_keys = true

# If the overlay never appears (binary missing?), switch anyway after this many ms.
fallback_ms = 400

# The effect replaces Hyprland's own workspace slide; set false to keep both.
disable_workspace_animation = true

# The binary to run, if it is not simply on your PATH.
# bin = /home/you/.local/bin/hyprtransition
